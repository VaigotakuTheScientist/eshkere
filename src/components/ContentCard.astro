---
import PrototypeBadge from './PrototypeBadge.astro';
import { formatDate, isoDate } from '../lib/format';

interface Props {
  href: string;
  title: string;
  excerpt: string;
  /** Display label for the content type, e.g. “Research”, “Blog”, “Tool”. */
  type: string;
  date?: Date;
  author?: string;
  tags?: string[];
  prototype?: boolean;
  /** Large featured variant for editorial grids. */
  featured?: boolean;
  /** Extra machine-readable attributes for client-side filtering. */
  data?: Record<string, string>;
}

const {
  href,
  title,
  excerpt,
  type,
  date,
  author,
  tags = [],
  prototype = false,
  featured = false,
  data = {},
} = Astro.props;

const dataAttrs = Object.fromEntries(
  Object.entries({
    type: type.toLowerCase(),
    date: date ? isoDate(date) : '',
    author: author ?? '',
    topics: tags.join('|'),
    title,
    ...data,
  }).map(([key, value]) => [`data-${key}`, value])
);
---

<article class:list={['content-card', 'panel', { 'content-card--featured': featured }]} {...dataAttrs}>
  <p class="content-card__meta">
    <span class="content-card__type">{type}</span>
    {date && <time datetime={isoDate(date)}>{formatDate(date)}</time>}
    {author && <span class="content-card__author">{author}</span>}
    {prototype && <PrototypeBadge />}
  </p>
  <h3 class="content-card__title">
    <a href={href}>{title}</a>
  </h3>
  <p class="content-card__excerpt">{excerpt}</p>
  {
    tags.length > 0 && (
      <ul class="content-card__tags" aria-label="Topics">
        {tags.map((tag) => (
          <li class="chip">{tag}</li>
        ))}
      </ul>
    )
  }
</article>

<style>
  .content-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    padding: clamp(1.4rem, 2.5vw, 1.9rem);
    transition: transform var(--speed-quick) var(--ease-out),
      border-color var(--speed-quick) var(--ease-out),
      box-shadow var(--speed-quick) var(--ease-out);
  }

  .content-card:hover {
    transform: translateY(-4px);
    border-color: var(--line-strong);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.45), var(--glow-pink);
  }

  .content-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.9rem;
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .content-card__type {
    font-family: var(--font-pixel);
    letter-spacing: 0.22em;
    color: var(--cyan);
  }

  .content-card__title {
    font-size: var(--text-xl);
    line-height: 1.2;
  }

  .content-card--featured .content-card__title {
    font-size: var(--text-2xl);
  }

  .content-card__title a {
    color: var(--ink);
    text-decoration: none;
  }

  /* Stretch the primary link across the whole card. */
  .content-card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .content-card__title a:hover {
    color: var(--pink);
  }

  .content-card__excerpt {
    color: var(--ink-soft);
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  .content-card--featured .content-card__excerpt {
    font-size: var(--text-base);
    max-width: 56ch;
  }

  .content-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: auto 0 0;
    padding: 0.4rem 0 0;
  }
</style>

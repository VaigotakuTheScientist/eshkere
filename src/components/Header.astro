---
import Logo from './Logo.astro';
import { primaryNav } from '../data/nav';
import { activeSection, activeChild, normalizePath } from '../lib/paths';
import { url } from '../lib/url';

const path = normalizePath(Astro.url.pathname);
const section = activeSection(Astro.url.pathname);
const secondaryActive = section ? activeChild(section, Astro.url.pathname) : undefined;
---

<header class="site-header">
  <div class="site-header__bar container">
    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-menu"
    >
      <span class="menu-toggle__line" aria-hidden="true"></span>
      <span class="menu-toggle__line" aria-hidden="true"></span>
      <span class="visually-hidden">Menu</span>
    </button>

    <Logo />

    <a
      class="search-link"
      href={url('/search')}
      aria-current={path === '/search' ? 'page' : undefined}
      aria-label="Search"
    >
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none"
        stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <circle cx="10.5" cy="10.5" r="6.5" />
        <path d="m15.5 15.5 5.5 5.5" />
      </svg>
    </a>
  </div>

  <div class="site-menu" id="site-menu" hidden>
    <nav aria-label="Site navigation">
      <ul class="site-menu__list container">
        {
          primaryNav.map((item) => (
            <li class="site-menu__group">
              <a
                class="site-menu__primary"
                href={url(item.href)}
                aria-current={
                  item.children
                    ? section?.href === item.href
                      ? 'true'
                      : undefined
                    : path === item.href
                      ? 'page'
                      : undefined
                }
              >
                {item.label}
              </a>
              {item.children && (
                <ul class="site-menu__children">
                  {item.children.map((child) => (
                    <li>
                      <a
                        href={url(child.href)}
                        aria-current={secondaryActive === child.href ? 'page' : undefined}
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector('.site-header');
  const button = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = document.getElementById('site-menu');

  if (header && button && menu) {
    const close = () => {
      button.setAttribute('aria-expanded', 'false');
      menu.hidden = true;
      header.classList.remove('menu-open');
      document.documentElement.classList.remove('menu-locked');
    };

    button.addEventListener('click', () => {
      const open = button.getAttribute('aria-expanded') === 'true';
      if (open) {
        close();
      } else {
        button.setAttribute('aria-expanded', 'true');
        menu.hidden = false;
        header.classList.add('menu-open');
        document.documentElement.classList.add('menu-locked');
        menu.querySelector<HTMLAnchorElement>('a')?.focus();
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && button.getAttribute('aria-expanded') === 'true') {
        close();
        button.focus();
      }
    });
  }
</script>

<style>
  .site-header {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: 100;
    transition: background-color var(--speed-quick) var(--ease-out),
      box-shadow var(--speed-quick) var(--ease-out);
  }

  /* The bar follows with no shading of its own; only an open menu
     darkens it so the panel below stays readable. */
  .site-header.menu-open {
    background: rgba(5, 5, 8, 0.9);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .site-header__bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding-block: 1.15rem;
  }

  /* --------------------------------------------------------- more button */
  .menu-toggle {
    justify-self: start;
    display: grid;
    align-content: center;
    gap: 0.5rem;
    width: 2.8rem;
    height: 2.8rem;
    padding: 0.5rem;
    border: 0;
    background: transparent;
    color: var(--pink);
    cursor: pointer;
  }

  .menu-toggle__line {
    display: block;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
    box-shadow: 0 0 10px rgba(255, 79, 200, 0.55);
    transition: transform var(--speed-quick) var(--ease-out),
      width var(--speed-quick) var(--ease-out);
  }

  .menu-toggle__line:nth-of-type(1) {
    width: 1.7rem;
  }

  .menu-toggle__line:nth-of-type(2) {
    width: 1.2rem;
  }

  .menu-toggle:hover .menu-toggle__line {
    width: 1.7rem;
  }

  .menu-toggle[aria-expanded='true'] .menu-toggle__line {
    width: 1.7rem;
  }

  .menu-toggle[aria-expanded='true'] .menu-toggle__line:nth-of-type(1) {
    transform: translateY(0.32rem) rotate(45deg);
  }

  .menu-toggle[aria-expanded='true'] .menu-toggle__line:nth-of-type(2) {
    transform: translateY(-0.32rem) rotate(-45deg);
  }

  /* -------------------------------------------------------------- search */
  .search-link {
    justify-self: end;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    border: 1px solid transparent;
    color: var(--ink-soft);
    transition: all var(--speed-quick) var(--ease-out);
  }

  .search-link:hover {
    color: var(--cyan);
    border-color: var(--line-strong);
    box-shadow: var(--glow-cyan);
  }

  /* ---------------------------------------------------------------- menu */
  .site-menu {
    position: fixed;
    inset-inline: 0;
    top: 4.9rem;
    z-index: 90;
    max-height: calc(100dvh - 4.9rem);
    overflow-y: auto;
    background: rgba(5, 5, 8, 0.96);
    border-bottom: 1px solid var(--line-soft);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }

  .site-menu__list {
    list-style: none;
    margin: 0;
    padding-block: clamp(1.75rem, 4vh, 3rem);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem 1.5rem;
  }

  .site-menu__primary {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 1.35rem;
    text-decoration: none;
    color: var(--ink);
    margin-bottom: 0.8rem;
  }

  .site-menu__children {
    list-style: none;
    margin: 0;
    padding: 0 0 0 0.9rem;
    border-left: 1px solid var(--line-strong);
    display: grid;
    gap: 0.5rem;
  }

  .site-menu__children a {
    text-decoration: none;
    color: var(--ink-soft);
    font-size: var(--text-sm);
  }

  .site-menu__children a:hover,
  .site-menu__primary:hover {
    color: var(--cyan);
  }

  .site-menu a[aria-current] {
    color: var(--pink);
  }

  :global(html.menu-locked) {
    overflow: hidden;
  }

  @media (max-width: 900px) {
    .site-menu {
      bottom: 0;
      border-bottom: 0;
    }

    .site-menu__list {
      grid-template-columns: 1fr;
      gap: 1.6rem;
      max-width: 30rem;
      padding-bottom: 4rem;
    }

    .site-menu__primary {
      font-size: 1.6rem;
      margin-bottom: 0.5rem;
    }

    .site-menu__children a {
      font-size: var(--text-base);
    }
  }
</style>

---
/** An 8-bit heart. Decorative only. */
interface Props {
  size?: number;
  color?: string;
  class?: string;
  style?: string;
}

const { size = 18, color = 'var(--pink)', class: className, style } = Astro.props;
---

<svg
  class:list={['pixel-heart', className]}
  viewBox="0 0 7 6"
  width={size}
  height={Math.round((size * 6) / 7)}
  style={style}
  aria-hidden="true"
>
  <g fill={color} shape-rendering="crispEdges">
    <rect x="1" y="0" width="2" height="1"></rect>
    <rect x="4" y="0" width="2" height="1"></rect>
    <rect x="0" y="1" width="7" height="2"></rect>
    <rect x="1" y="3" width="5" height="1"></rect>
    <rect x="2" y="4" width="3" height="1"></rect>
    <rect x="3" y="5" width="1" height="1"></rect>
  </g>
</svg>

<style>
  .pixel-heart {
    filter: drop-shadow(0 0 8px currentColor);
  }
</style>

---
/**
 * The visible way in.
 *
 * The spec is explicit that a trackpad gesture must never be the only route
 * into the universe, so this control carries the same weight as the hero's
 * other calls to action and is reachable by keyboard like any button.
 */
---

<button class="universe-launch" type="button" data-universe-open>
  <span class="universe-launch__glyph" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor"
      stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
      <path d="M9 3H5a2 2 0 0 0-2 2v4" />
      <path d="M15 3h4a2 2 0 0 1 2 2v4" />
      <path d="M9 21H5a2 2 0 0 1-2-2v-4" />
      <path d="M15 21h4a2 2 0 0 0 2-2v-4" />
      <circle cx="12" cy="12" r="2.6" />
    </svg>
  </span>
  <span class="universe-launch__text">Zoom out to the universe</span>
</button>

<style>
  .universe-launch {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 1.15rem 0.6rem 0.8rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill);
    background: rgba(5, 5, 8, 0.42);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    color: var(--ink);
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      border-color var(--speed-quick) var(--ease-out),
      box-shadow var(--speed-quick) var(--ease-out),
      color var(--speed-quick) var(--ease-out);
  }

  .universe-launch:hover,
  .universe-launch:focus-visible {
    border-color: rgba(77, 227, 255, 0.6);
    color: #ffffff;
    box-shadow:
      0 0 0 1px rgba(77, 227, 255, 0.25),
      0 0 34px rgba(77, 227, 255, 0.28);
  }

  .universe-launch__glyph {
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(77, 227, 255, 0.25), transparent 70%);
    color: var(--cyan);
  }

  /* The frame breathes outward — the gesture the button performs. */
  .universe-launch:hover .universe-launch__glyph svg {
    animation: universe-launch-pull 1.6s var(--ease-out) infinite;
  }

  @keyframes universe-launch-pull {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(0.86);
    }
  }

  @media (max-width: 700px) {
    .universe-launch__text {
      letter-spacing: 0.14em;
      font-size: 0.66rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .universe-launch:hover .universe-launch__glyph svg {
      animation: none;
    }
  }
</style>

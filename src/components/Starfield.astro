---
/**
 * A seeded, build-time starfield — rendered once as static SVG so every
 * visit gets the same sky with zero runtime JavaScript.
 */
interface Props {
  count?: number;
  class?: string;
}

const { count = 130, class: className } = Astro.props;

// Deterministic PRNG so the sky doesn't reshuffle on every build.
function mulberry32(seed: number) {
  return () => {
    seed |= 0;
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const rand = mulberry32(20260818);
const palette = ['#f4f1ff', '#f4f1ff', '#f4f1ff', '#5ce8ff', '#ff64cd', '#cef54d'];

const stars = Array.from({ length: count }, (_, i) => ({
  x: +(rand() * 100).toFixed(2),
  y: +(rand() * 100).toFixed(2),
  r: +(0.4 + rand() * 1.1).toFixed(2),
  o: +(0.25 + rand() * 0.65).toFixed(2),
  color: palette[Math.floor(rand() * palette.length)],
  twinkle: i % 9 === 0,
  delay: +(rand() * 6).toFixed(2),
}));
---

<svg
  class:list={['starfield', className]}
  viewBox="0 0 100 100"
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
>
  {
    stars.map((star) => (
      <circle
        cx={star.x}
        cy={star.y}
        r={star.r * 0.12}
        fill={star.color}
        opacity={star.o}
        class:list={{ 'starfield__twinkle': star.twinkle }}
        style={star.twinkle ? `animation-delay: ${star.delay}s` : undefined}
      />
    ))
  }
</svg>

<style>
  .starfield {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .starfield__twinkle {
    animation: twinkle 5.5s ease-in-out infinite;
  }

  @keyframes twinkle {
    0%,
    100% {
      opacity: 0.15;
    }
    50% {
      opacity: 0.95;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .starfield__twinkle {
      animation: none;
    }
  }
</style>

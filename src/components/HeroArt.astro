---
import { Picture } from 'astro:assets';
import { heroArtworks, markFace } from '../data/hero-art';
import { url } from '../lib/url';

/**
 * The homepage hero artwork: one or more full-bleed images, the clickable
 * regions baked into them, and — when more than one artwork exists — a
 * switcher for comparing them.
 *
 * The image and the hotspot layer share one animated stage, so the drift
 * moves both together and the click targets never drift off their marks.
 */
const artworks = heroArtworks;
// The group is always present now: it is where the universe is entered, not
// only where artwork is compared.
const showArtworkOptions = artworks.length > 1;
---

<div class="hero__stage">
  {
    artworks.map((art, index) => (
      <div
        class="hero__art"
        data-art-image={art.id}
        data-art-theme={art.theme}
        data-art-planet={`${art.planet.cx},${art.planet.cy},${art.planet.r}`}
        data-art-mark={(() => {
          const mark = markFace(art);
          return mark ? `${mark.x},${mark.y},${mark.r}` : undefined;
        })()}
        style={`--focus-desktop: ${art.focus.desktop}; --focus-mobile: ${art.focus.mobile}`}
        hidden={index > 0}
        aria-hidden="true"
      >
        <Picture
          src={art.src}
          formats={['avif', 'webp']}
          fallbackFormat="png"
          widths={[768, 1280, 1672]}
          sizes="100vw"
          alt=""
          loading={index === 0 ? 'eager' : 'lazy'}
          fetchpriority={index === 0 ? 'high' : 'auto'}
        />
      </div>
    ))
  }

  {
    artworks.map((art, index) => (
      <div class="hero__hotspots" data-art-hotspots={art.id} hidden={index > 0}>
        {art.hotspots.map((spot) => {
          const external = /^https?:\/\//i.test(spot.href);
          return (
            /* Authored in source pixels, emitted as fractions: the browser may
               load any responsive variant, so only ratios survive the trip. */
            <a
              class="hero__hotspot"
              href={url(spot.href)}
              target={external ? '_blank' : undefined}
              rel={external ? 'noopener noreferrer' : undefined}
              data-shape={spot.shape}
              style={spot.rotate ? `--hotspot-rotate: ${spot.rotate}deg` : undefined}
              data-fx={spot.x / art.src.width}
              data-fy={spot.y / art.src.height}
              data-fw={spot.w / art.src.width}
              data-fh={spot.h / art.src.height}
            >
              <span class="visually-hidden">
                {spot.label}
                {external ? ' (opens in a new tab)' : ''}
              </span>
            </a>
          );
        })}
      </div>
    ))
  }
</div>

<div class="art-switcher" role="group" aria-label="View">
  <span class="art-switcher__label" aria-hidden="true">View</span>
  {
    showArtworkOptions &&
      artworks.map((art, index) => (
        <button
          class="art-switcher__option"
          type="button"
          data-art-choice={art.id}
          aria-pressed={index === 0 ? 'true' : 'false'}
        >
          {art.label}
        </button>
      ))
  }
  <span class="art-switcher__rule" aria-hidden="true"></span>
  <button
    class="art-switcher__option art-switcher__option--universe"
    type="button"
    data-universe-open
    aria-pressed="false"
  >
    <svg viewBox="0 0 24 24" width="13" height="13" aria-hidden="true" fill="none"
      stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
      <path d="M9 3H5a2 2 0 0 0-2 2v4" />
      <path d="M15 3h4a2 2 0 0 1 2 2v4" />
      <path d="M9 21H5a2 2 0 0 1-2-2v-4" />
      <path d="M15 21h4a2 2 0 0 0 2-2v-4" />
      <circle cx="12" cy="12" r="2.4" />
    </svg>
    Universe
  </button>
</div>

<script>
  const stage = document.querySelector<HTMLElement>('.hero__stage');

  if (stage) {
    const images = [...stage.querySelectorAll<HTMLElement>('[data-art-image]')];
    const layers = [...stage.querySelectorAll<HTMLElement>('[data-art-hotspots]')];
    const options = [...document.querySelectorAll<HTMLButtonElement>('[data-art-choice]')];
    const STORAGE_KEY = 'eshkere:hero-art';

    /**
     * Map a rectangle given in the source image's pixels onto the rendered
     * image, accounting for object-fit: cover and the current
     * object-position.
     */
    const placeHotspots = (layer: HTMLElement) => {
      const id = layer.dataset.artHotspots;
      const wrapper = images.find((image) => image.dataset.artImage === id);
      const img = wrapper?.querySelector('img');
      if (!img || !img.naturalWidth) return;

      const cw = img.clientWidth;
      const ch = img.clientHeight;
      const scale = Math.max(cw / img.naturalWidth, ch / img.naturalHeight);
      const renderedWidth = img.naturalWidth * scale;
      const renderedHeight = img.naturalHeight * scale;

      const [rawX, rawY] = getComputedStyle(img).objectPosition.split(' ');
      const posX = parseFloat(rawX) / 100 || 0;
      const posY = parseFloat(rawY) / 100 || 0;
      const offsetX = (cw - renderedWidth) * posX;
      const offsetY = (ch - renderedHeight) * posY;

      layer.querySelectorAll<HTMLAnchorElement>('.hero__hotspot').forEach((spot) => {
        spot.style.left = `${offsetX + Number(spot.dataset.fx) * renderedWidth}px`;
        spot.style.top = `${offsetY + Number(spot.dataset.fy) * renderedHeight}px`;
        spot.style.width = `${Number(spot.dataset.fw) * renderedWidth}px`;
        spot.style.height = `${Number(spot.dataset.fh) * renderedHeight}px`;
      });
    };

    const placeVisible = () => {
      layers.filter((layer) => !layer.hidden).forEach(placeHotspots);
    };

    const hero = document.querySelector<HTMLElement>('.hero');

    const select = (id: string) => {
      images.forEach((image) => {
        image.hidden = image.dataset.artImage !== id;
        if (hero && image.dataset.artImage === id && image.dataset.artTheme) {
          hero.dataset.heroTheme = image.dataset.artTheme;
        }
      });
      layers.forEach((layer) => {
        layer.hidden = layer.dataset.artHotspots !== id;
      });
      options.forEach((option) => {
        option.setAttribute('aria-pressed', String(option.dataset.artChoice === id));
      });
      placeVisible();
    };

    options.forEach((option) => {
      option.addEventListener('click', () => {
        const id = option.dataset.artChoice;
        if (!id) return;
        select(id);
        try {
          localStorage.setItem(STORAGE_KEY, id);
        } catch {
          /* storage unavailable — the choice simply doesn't persist */
        }
      });
    });

    let stored: string | null = null;
    try {
      stored = localStorage.getItem(STORAGE_KEY);
    } catch {
      /* ignore */
    }
    if (stored && images.some((image) => image.dataset.artImage === stored)) {
      select(stored);
    }

    placeVisible();
    window.addEventListener('resize', placeVisible, { passive: true });
    images.forEach((wrapper) => {
      const img = wrapper.querySelector('img');
      if (img && !img.complete) img.addEventListener('load', placeVisible, { once: true });
    });
  }
</script>

<style>
  .hero__stage {
    position: absolute;
    inset: 0;
    animation: planet-drift 24s ease-in-out infinite alternate;
  }

  @keyframes planet-drift {
    from {
      transform: scale(1.02) translateY(0);
    }
    to {
      transform: scale(1.045) translateY(-0.6%);
    }
  }

  .hero__art,
  .hero__art :global(picture),
  .hero__art :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero__art {
    overflow: hidden;
  }

  .hero__art :global(img) {
    object-fit: cover;
    object-position: var(--focus-desktop, 62% 38%);
  }

  /* ------------------------------------------------------------ hotspots */
  .hero__hotspots {
    position: absolute;
    inset: 0;
  }

  .hero__hotspot {
    position: absolute;
    display: block;
    /* Invisible until interacted with: the artwork already draws the mark,
       so the lighting only has to follow its outline. */
    transform: rotate(var(--hotspot-rotate, 0deg));
    outline-offset: 4px;
    transition: box-shadow var(--speed-quick) var(--ease-out),
      background-color var(--speed-quick) var(--ease-out);
  }

  /* The round badge. */
  .hero__hotspot[data-shape='circle'] {
    border-radius: 50%;
  }

  /* The tilted plaque — corner radius scales with the box so it matches
     the drawn one at every viewport size. */
  .hero__hotspot[data-shape='plaque'] {
    border-radius: 11%/16%;
  }

  .hero__hotspot:hover,
  .hero__hotspot:focus-visible {
    background: rgba(255, 255, 255, 0.05);
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.28),
      0 0 30px rgba(255, 79, 200, 0.4);
  }

  /* Keep the focus ring on the mark's own outline rather than a box. */
  .hero__hotspot:focus-visible {
    outline: none;
  }

  /* --------------------------------------------------------- switcher */
  .art-switcher {
    position: absolute;
    right: clamp(1.25rem, 4vw, 3rem);
    bottom: clamp(1.25rem, 4vh, 2.5rem);
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.4rem 0.7rem;
    border: 1px solid var(--line-soft);
    border-radius: var(--radius-pill);
    background: rgba(5, 5, 8, 0.6);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .art-switcher__label {
    padding-right: 0.5rem;
    border-right: 1px solid var(--line-soft);
    color: var(--cyan);
    font-size: 0.58rem;
    letter-spacing: 0.24em;
  }

  .art-switcher__option {
    padding: 0.15rem 0.35rem;
    border: 0;
    background: transparent;
    color: var(--ink-faint);
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    cursor: pointer;
    transition: color var(--speed-quick) var(--ease-out);
  }

  .art-switcher__option:hover {
    color: var(--cyan);
  }

  .art-switcher__option[aria-pressed='true'] {
    color: var(--ink);
    text-shadow: -0.05em 0 var(--cyan), 0.05em 0 var(--pink);
  }

  /* ---------------------------------------------------- universe option
     The third view. It sits with the artwork options because it is one —
     the same scene, seen from much further away — rather than a separate
     call to action competing with the hero's own. */
  .art-switcher__rule {
    width: 1px;
    height: 1.1rem;
    background: var(--line-soft);
  }

  .art-switcher__option--universe {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding-left: 0.15rem;
    color: var(--cyan);
  }

  .art-switcher__option--universe:hover,
  .art-switcher__option--universe:focus-visible {
    color: #ffffff;
    text-shadow: 0 0 14px rgba(77, 227, 255, 0.75);
  }

  /* The frame draws inward: the gesture the control performs. */
  .art-switcher__option--universe:hover svg {
    animation: universe-pull 1.6s var(--ease-out) infinite;
  }

  @keyframes universe-pull {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(0.82);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .art-switcher__option--universe:hover svg {
      animation: none;
    }
  }

  @media (max-width: 900px) {
    .hero__art :global(img) {
      object-position: var(--focus-mobile, 68% 30%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__stage {
      animation: none;
    }
  }
</style>

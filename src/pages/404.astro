---
import BaseLayout from '../layouts/BaseLayout.astro';
import Starfield from '../components/Starfield.astro';
import PixelHeart from '../components/PixelHeart.astro';
import Sparkle from '../components/Sparkle.astro';
import { url } from '../lib/url';
---

<BaseLayout title="Page not found" description="404 — this page drifted out of orbit.">
  <section class="lost">
    <Starfield count={90} />
    <div class="lost__inner container">
      <p class="lost__code" aria-hidden="true">
        4<span class="lost__heart"><PixelHeart size={52} color="var(--pink)" /></span>4
      </p>
      <h1>Lost in orbit</h1>
      <p class="lost__body">
        This page doesn't exist — or hasn't been built yet. On a site this young, both are
        genuinely possible.
      </p>
      <div class="lost__actions">
        <a class="btn btn--solid" href={url('/')}>Return home</a>
        <a class="btn btn--ghost" href={url('/search')}>Search the site</a>
      </div>
      <p class="lost__continue">
        <Sparkle size={12} color="var(--lime)" /> Continue? Health first, then choose your next game.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .lost {
    position: relative;
    min-height: 65vh;
    display: grid;
    place-items: center;
    overflow: hidden;
    padding-block: 5rem;
    background:
      radial-gradient(45rem 26rem at 50% 20%, rgba(160, 110, 255, 0.16), transparent 70%),
      var(--space-black);
  }

  .lost__inner {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 1.25rem;
    text-align: center;
  }

  .lost__code {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-display);
    font-size: clamp(4.5rem, 12vw, 8rem);
    line-height: 1;
    color: var(--ink);
    text-shadow: 0 0 40px rgba(255, 100, 205, 0.4);
  }

  .lost__heart {
    display: inline-grid;
    place-items: center;
    animation: heartbeat 1.8s ease-in-out infinite;
  }

  @keyframes heartbeat {
    0%,
    100% {
      transform: scale(1);
    }
    12% {
      transform: scale(1.14);
    }
    24% {
      transform: scale(1);
    }
  }

  .lost h1 {
    font-size: var(--text-2xl);
  }

  .lost__body {
    color: var(--ink-soft);
    max-width: 30rem;
  }

  .lost__actions {
    display: flex;
    gap: 0.9rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 0.5rem;
  }

  .lost__continue {
    margin-top: 1.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-pixel);
    font-size: 0.7rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  @media (prefers-reduced-motion: reduce) {
    .lost__heart {
      animation: none;
    }
  }
</style>

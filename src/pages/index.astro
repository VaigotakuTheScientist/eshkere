---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroArt from '../components/HeroArt.astro';
import Sparkle from '../components/Sparkle.astro';
import PixelHeart from '../components/PixelHeart.astro';
import ContentCard from '../components/ContentCard.astro';
import EmptyState from '../components/EmptyState.astro';
import PrototypeBadge from '../components/PrototypeBadge.astro';
import { siteConfig } from '../data/site';
import { url } from '../lib/url';
import { titleCase } from '../lib/format';
import { heroArtworks } from '../data/hero-art';

const portfolio = (await getCollection('portfolio')).filter((entry) => !entry.data.prototype);

const research = (await getCollection('research')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const featured = research.find((entry) => entry.data.featured) ?? research[0];
const secondary = research.filter((entry) => entry.id !== featured?.id).slice(0, 3);
const hasSamples = research.some((entry) => entry.data.prototype);
---

<BaseLayout title={siteConfig.name} overlayHeader>
  <!-- ============================================================ hero -->
  <section class="hero" aria-labelledby="hero-heading" data-hero-theme={heroArtworks[0].theme}>
    <HeroArt />
    <div class="hero__vignette" aria-hidden="true"></div>

    <div class="container hero__content">
      <h1 class="hero__heading" id="hero-heading">
        <span>Maximize</span><br /><span>Health, Play&nbsp;Games</span>
      </h1>
      <p class="hero__support">Health is non-optional. Everything else is a game.</p>
      <div class="hero__ctas">
        <a class="arrow-link arrow-link--accent" href={url('/our-approach')}>Explore our approach</a>
        <a class="arrow-link" href={url('/portfolio')}>View portfolio</a>
      </div>
    </div>
  </section>

  <!-- ================================================== health & games -->
  <section class="section duality" aria-labelledby="duality-heading">
    <div class="container">
      <p class="eyebrow">The thesis</p>
      <h2 class="duality__heading" id="duality-heading">One foundation. Infinite games.</h2>

      <div class="duality__grid">
        <article class="duality__card duality__card--health panel">
          <p class="duality__label duality__label--health">
            <svg viewBox="0 0 40 12" width="40" height="12" aria-hidden="true">
              <polyline points="0,7 12,7 16,1 21,11 25,4 28,7 40,7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round"></polyline>
            </svg>
            Health
          </p>
          <h3 class="duality__title">The non-optional foundation</h3>
          <p class="duality__body">
            <strong>Everyone has a right to health</strong> — the conditions and needs underlying
            physical, mental and social flourishing. Sleep, movement, nourishment, connection, a
            mind that works. Health is serious because nobody can opt out of needing it, and
            everything else stands on top of it.
          </p>
        </article>

        <article class="duality__card duality__card--games panel">
          <p class="duality__label duality__label--games">
            <PixelHeart size={15} color="currentColor" />
            Games
          </p>
          <h3 class="duality__title">Everything you choose on top</h3>
          <p class="duality__body">
            The optional ways people pursue enjoyment, achievement, relationships, exploration,
            creativity, knowledge, identity and meaning. Optional by definition — and where almost
            everything people cherish about being alive actually lives.
          </p>
        </article>
      </div>

      <p class="duality__bridge">
        Games depend on health. That is why the foundation comes
        first — <em>and why it is never the whole point.</em>
      </p>
    </div>
  </section>

  <!-- ====================================================== the stakes -->
  <section class="section stakes" aria-labelledby="stakes-heading">
    <div class="container--narrow stakes__inner">
      <p class="eyebrow eyebrow--pink">The stakes</p>
      <h2 id="stakes-heading">The floor is not secure.</h2>
      <p>
        For a great many people it never has been. Health is lost to poverty, illness, violence,
        isolation and neglect — and every game those people might have chosen is lost with it.
        That is a present fact, not an abstraction.
      </p>
      <p>
        A floor that holds today can also be undermined tomorrow. Some of the plausible ways are
        global rather than local — how powerful AI systems are built and governed among them,
        alongside conflict, pandemics and ecological damage.
      </p>
      <p>
        So health first is not only a private ordering. Where the foundation is missing or
        threatened, securing it is a <strong>public good</strong> — making the floor real for
        people beyond yourself, and keeping it standing for the people who come next.
      </p>
      <p class="stakes__note">
        Which of these problems Eshkere is actually positioned to help
        with <a href={url('/our-approach#open-heading')}>is still an open question</a>.
      </p>
    </div>
  </section>

  <!-- ============================================== featured portfolio -->
  <section class="section portfolio-teaser" aria-labelledby="portfolio-heading">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow eyebrow--pink">Portfolio</p>
          <h2 id="portfolio-heading">What we're building</h2>
        </div>
        <a class="section-head__link" href={url('/portfolio')}>Browse the portfolio →</a>
      </div>

      {
        portfolio.length > 0 ? (
          <div class="card-grid">
            {portfolio.slice(0, 3).map((entry) => (
              <ContentCard
                href={url(`/portfolio/${entry.id}`)}
                title={entry.data.title}
                excerpt={entry.data.summary}
                type={titleCase(entry.data.category)}
                date={entry.data.date}
                tags={entry.data.tags}
              />
            ))}
          </div>
        ) : (
          <EmptyState
            title="Eshkere’s portfolio is taking shape."
            body="No projects, programs or supported work are published yet. When real entries exist, they will appear here — nothing on this site is invented to look further along than it is."
          >
            <a class="btn btn--ghost" href={url('/portfolio')}>See how the portfolio will work</a>
          </EmptyState>
        )
      }
    </div>
  </section>

  <!-- ================================================= research & news -->
  <section class="section research-teaser" aria-labelledby="research-heading">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow eyebrow--lime">Research &amp; News</p>
          <h2 id="research-heading">Thinking in public</h2>
        </div>
        <a class="section-head__link" href={url('/research-and-news')}>All research &amp; news →</a>
      </div>

      {
        featured ? (
          <div class="research-teaser__grid">
            <ContentCard
              featured
              href={url(`/research-and-news/${featured.id}`)}
              title={featured.data.title}
              excerpt={featured.data.excerpt}
              type={titleCase(featured.data.type)}
              date={featured.data.date}
              author={featured.data.author}
              tags={featured.data.topics}
              prototype={featured.data.prototype}
            />
            <div class="research-teaser__stack">
              {secondary.map((entry) => (
                <ContentCard
                  href={url(`/research-and-news/${entry.id}`)}
                  title={entry.data.title}
                  excerpt={entry.data.excerpt}
                  type={titleCase(entry.data.type)}
                  date={entry.data.date}
                  author={entry.data.author}
                  prototype={entry.data.prototype}
                />
              ))}
            </div>
          </div>
        ) : (
          <EmptyState
            title="Research forthcoming."
            body="Nothing has been published yet. Real writing will land here as the thinking matures."
          />
        )
      }

      {
        hasSamples && (
          <p class="sample-note">
            <PrototypeBadge /> entries are placeholder content demonstrating the editorial system —
            not real publications.
          </p>
        )
      }
    </div>
  </section>

  <!-- ================================================= approach teaser -->
  <section class="section approach-teaser" aria-labelledby="approach-heading">
    <div class="container--narrow approach-teaser__inner">
      <Sparkle size={16} color="var(--lime)" />
      <h2 id="approach-heading">Health is the floor. Games are the point.</h2>
      <p>
        Eshkere is built on a single ordering: secure the non-optional foundation of physical,
        mental and social well-being — then choose your games and play them wholeheartedly. How
        that becomes projects, programs and support is still being worked out, in public.
      </p>
      <a class="btn btn--ghost" href={url('/our-approach')}>Read the complete approach</a>
    </div>
  </section>

  <!-- ================================================ partner with us -->
  <section class="section partner-cta" aria-labelledby="partner-heading">
    <div class="container partner-cta__inner panel">
      <div>
        <p class="eyebrow eyebrow--pink">Partner with us</p>
        <h2 id="partner-heading">Early is the interesting part.</h2>
        <p class="partner-cta__body">
          Eshkere is an early-stage exploration, which means collaborators can still shape what it
          becomes — builders, researchers, funders and creative partners alike.
        </p>
        {
          !siteConfig.partnershipContact && (
            <p class="partner-cta__forthcoming">
              Partnership details forthcoming — a real contact channel will be published here once
              it exists.
            </p>
          )
        }
      </div>
      <a class="btn btn--solid" href={url('/about-us/partner-with-us')}>How partnership could work</a>
    </div>
  </section>
</BaseLayout>

<style>
  /* ------------------------------------------------------------- hero */
  .hero {
    position: relative;
    min-height: max(94vh, 44rem);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background:
      radial-gradient(60rem 40rem at 70% 32%, rgba(27, 47, 168, 0.14), transparent 62%),
      var(--space-black);
    padding-top: 7rem;
    padding-bottom: clamp(3rem, 6vh, 5rem);
  }

  .hero__vignette {
    position: absolute;
    inset: 0;
    pointer-events: none;
    /* Darkening is pooled under the headline instead of washing across the
       whole frame, so the artwork's own neon marks stay at full strength. */
    background:
      radial-gradient(
        88% 66% at 16% 102%,
        rgba(5, 5, 8, 0.9) 0%,
        rgba(5, 5, 8, 0.5) 42%,
        rgba(5, 5, 8, 0) 76%
      ),
      linear-gradient(0deg, var(--space-black) 0%, rgba(5, 5, 8, 0.3) 9%, rgba(5, 5, 8, 0) 24%);
  }

  .hero__content {
    position: relative;
    z-index: 2;
    display: grid;
    gap: 1.5rem;
    justify-items: start;
    /* The block spans the full container, so let its empty area pass
       clicks through to the artwork's own hotspots behind it. */
    pointer-events: none;
  }

  .hero__content > * {
    pointer-events: auto;
  }

  .hero__heading {
    font-size: var(--text-hero);
    font-weight: 520;
    line-height: 1.06;
    letter-spacing: 0.012em;
    text-transform: uppercase;
  }

  /* Exactly two lines, at every width. */
  .hero__heading span {
    white-space: nowrap;
  }

  /* --- artwork themes -------------------------------------------------
     Each hero artwork picks the treatment that survives its backdrop;
     the switcher swaps them live. */

  /* Quiet dark space behind the text: brushed silver reads beautifully. */
  .hero[data-hero-theme='silver'] .hero__heading {
    background: linear-gradient(178deg, #ffffff 20%, #eceafb 55%, #b0adcc 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 4px 30px rgba(5, 5, 8, 0.9));
  }

  /* Busy nebula behind the text: solid white with a chromatic split and a
     glow, so the letters hold their edges over stars and colour. */
  .hero[data-hero-theme='neon'] .hero__heading {
    background: none;
    color: #ffffff;
    text-shadow:
      0.045em 0 rgba(255, 79, 200, 0.9),
      -0.03em 0 rgba(77, 227, 255, 0.85),
      0 0 0.7em rgba(157, 107, 255, 0.5),
      0 0.06em 0.5em rgba(5, 5, 8, 0.95);
  }

  .hero[data-hero-theme='neon'] .hero__support {
    color: var(--ink);
    text-shadow: 0 0.06em 0.6em rgba(5, 5, 8, 0.95);
  }

  /* The nebula reaches further into the text column, so darken behind it. */
  .hero[data-hero-theme='neon'] .hero__vignette {
    background:
      radial-gradient(
        92% 70% at 14% 104%,
        rgba(5, 5, 8, 0.94) 0%,
        rgba(5, 5, 8, 0.58) 44%,
        rgba(5, 5, 8, 0) 78%
      ),
      linear-gradient(0deg, var(--space-black) 0%, rgba(5, 5, 8, 0.38) 10%, rgba(5, 5, 8, 0) 26%);
  }

  .hero__support {
    font-size: var(--text-lg);
    color: var(--ink-soft);
    display: flex;
    align-items: center;
    gap: 1.1rem;
  }

  .hero__support::after {
    content: '';
    width: 4.5rem;
    height: 9px;
    background: var(--pink);
    clip-path: polygon(0 44%, 90% 44%, 87% 0, 100% 50%, 87% 100%, 90% 56%, 0 56%);
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem 2.75rem;
    margin-top: 0.9rem;
  }

  @media (max-width: 900px) {
    .hero {
      align-items: flex-end;
      min-height: 100svh;
      padding-top: 0;
    }

    .hero__vignette {
      background:
        linear-gradient(0deg, var(--space-black) 0%, rgba(5, 5, 8, 0.45) 30%, rgba(5, 5, 8, 0.05) 60%);
    }
  }

  /* -------------------------------------------------- health & games */
  .duality .eyebrow {
    text-align: center;
    display: block;
  }

  .duality__heading {
    text-align: center;
    font-size: var(--text-2xl);
    margin: 0.75rem auto 3rem;
    max-width: 24ch;
  }

  .duality__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    align-items: stretch;
  }

  .duality__card {
    padding: clamp(1.75rem, 3.5vw, 2.75rem);
    display: grid;
    gap: 1rem;
    align-content: start;
    position: relative;
    overflow: hidden;
  }

  .duality__card--health {
    border-color: rgba(77, 227, 255, 0.28);
    background:
      radial-gradient(28rem 16rem at 15% 0%, rgba(77, 227, 255, 0.07), transparent 70%),
      linear-gradient(165deg, rgba(255, 255, 255, 0.03), rgba(255, 255, 255, 0.005));
  }

  .duality__card--games {
    border-color: rgba(255, 79, 200, 0.28);
    background:
      radial-gradient(28rem 16rem at 85% 0%, rgba(255, 79, 200, 0.07), transparent 70%),
      linear-gradient(165deg, rgba(255, 255, 255, 0.03), rgba(255, 255, 255, 0.005));
    /* Games sit on top of the foundation — nudged up on desktop. */
    transform: translateY(-1.25rem);
  }

  .duality__label {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.34em;
    text-transform: uppercase;
  }

  .duality__label--health { color: var(--cyan); }
  .duality__label--games { color: var(--pink); }

  .duality__title {
    font-size: var(--text-xl);
  }

  .duality__body {
    color: var(--ink-soft);
  }

  .duality__bridge {
    text-align: center;
    max-width: 44rem;
    margin: 3rem auto 0;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    color: var(--ink);
  }

  .duality__bridge em {
    color: var(--peach);
    font-style: italic;
  }

  @media (max-width: 800px) {
    .duality__grid {
      grid-template-columns: 1fr;
    }

    .duality__card--games {
      transform: none;
    }
  }

  /* --------------------------------------------------- the stakes */
  .stakes {
    background:
      radial-gradient(48rem 22rem at 50% 0%, rgba(255, 79, 200, 0.07), transparent 70%);
  }

  .stakes__inner {
    display: grid;
    gap: 1.15rem;
  }

  .stakes__inner h2 {
    font-size: var(--text-2xl);
    max-width: 18ch;
  }

  .stakes__inner p {
    color: var(--ink-soft);
  }

  .stakes__inner strong {
    color: var(--ink);
  }

  .stakes__note {
    margin-top: 0.5rem;
    font-size: var(--text-sm);
    color: var(--ink-faint);
  }

  .duality__body strong {
    color: var(--ink);
  }

  /* -------------------------------------------------- section heads */
  .section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-bottom: 2.25rem;
  }

  .section-head h2 {
    font-size: var(--text-2xl);
    margin-top: 0.5rem;
  }

  .section-head__link {
    font-size: var(--text-sm);
    color: var(--ink-soft);
    text-decoration: none;
    letter-spacing: 0.04em;
  }

  .section-head__link:hover {
    color: var(--cyan);
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: 1.5rem;
  }

  /* ---------------------------------------------------- research grid */
  .research-teaser__grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 1.5rem;
    align-items: start;
  }

  .research-teaser__stack {
    display: grid;
    gap: 1.5rem;
  }

  .sample-note {
    margin-top: 1.75rem;
    color: var(--ink-faint);
    font-size: var(--text-sm);
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  @media (max-width: 900px) {
    .research-teaser__grid {
      grid-template-columns: 1fr;
    }
  }

  /* -------------------------------------------------- approach teaser */
  .approach-teaser {
    background:
      radial-gradient(50rem 24rem at 50% 0%, rgba(160, 110, 255, 0.12), transparent 70%);
  }

  .approach-teaser__inner {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 1.25rem;
  }

  .approach-teaser h2 {
    font-size: var(--text-2xl);
    max-width: 22ch;
  }

  .approach-teaser p {
    color: var(--ink-soft);
    max-width: 40rem;
  }

  /* ------------------------------------------------------ partner cta */
  .partner-cta__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
    padding: clamp(2rem, 4vw, 3.25rem);
  }

  .partner-cta__inner h2 {
    font-size: var(--text-2xl);
    margin-block: 0.6rem 0.9rem;
  }

  .partner-cta__body {
    color: var(--ink-soft);
    max-width: 34rem;
  }

  .partner-cta__forthcoming {
    margin-top: 0.9rem;
    font-size: var(--text-sm);
    color: var(--peach);
  }

  /* Phones get a larger headline; the long line is allowed to wrap there,
     since holding it to two lines would shrink the type too far. */
  @media (max-width: 700px) {
    .hero__heading {
      font-size: clamp(2.5rem, 12.5vw, 3.6rem);
    }

    .hero__heading span {
      white-space: normal;
    }
  }
</style>

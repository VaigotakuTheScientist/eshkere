---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../../layouts/ArticleLayout.astro';
import { titleCase } from '../../../lib/format';

export async function getStaticPaths() {
  const works = await getCollection('staffWork');
  return works.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<ArticleLayout
  title={entry.data.title}
  description={entry.data.excerpt}
  typeLabel={titleCase(entry.data.kind)}
  date={entry.data.date}
  author={entry.data.author}
  tags={entry.data.topics}
  prototype={entry.data.prototype}
  backHref="/research-and-news/staff-publications-and-projects"
  backLabel="Back to Staff Publications & Projects"
>
  <Content />
</ArticleLayout>
